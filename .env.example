# Пароль для входа на сайт (обязательно на Vercel; локально по умолчанию "dev")
APP_PASSWORD=change-me
# Необязательно: отдельный секрет для подписи токенов. Если не задан — используется APP_PASSWORD
# AUTH_SECRET=long-random-string
